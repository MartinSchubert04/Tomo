# Configuración de la app (copiar a deploy/.env, que no se commitea). deploy.sh la crea sola.

# Primer admin: se crea solo si todavía no hay ningún usuario. Después se puede borrar de acá.
LIBRARY_ADMIN_USER=admin
LIBRARY_ADMIN_PASSWORD=cambiame-por-algo-largo

# Repo de extensiones que se agrega a Suwayomi si no tiene ninguno.
LIBRARY_EXTENSION_REPO=https://raw.githubusercontent.com/keiyoushi/extensions/repo/index.min.json

# Tamaño máximo de cada archivo subido, en MB.
LIBRARY_MAX_UPLOAD_MB=1024

# Horas entre búsquedas de capítulos nuevos de lo que está en las bibliotecas (0 = nunca).
LIBRARY_UPDATE_HOURS=6

# Títulos en otros idiomas para las sugerencias de la búsqueda ("attack on titan" → "Shingeki no
# Kyojin"). Vacío = sin AniList (solo sugiere lo conocido).
# LIBRARY_ANILIST_URL=https://graphql.anilist.co

# Catálogos de libros gratis y legales (Libros → Libros gratis). Cada uno se apaga dejándolo vacío.
# LIBRARY_ELEJANDRIA_URL=https://www.elejandria.com
# LIBRARY_TEXTOS_URL=https://www.textos.info/opds
# LIBRARY_ARCHIVE_URL=https://archive.org
# LIBRARY_GUTENBERG_URL=https://www.gutenberg.org/ebooks.opds/
# Open Library completa autor, año, sinopsis y portada de los libros que no los traen. Vacío = no.
# LIBRARY_OPENLIBRARY_URL=https://openlibrary.org

# Carpeta de entrada: lo que se deje en deploy/data/library/inbox se importa solo. Cada cuántos
# segundos se revisa (0 = nunca) y la ruta que muestra Admin → Catálogos.
# LIBRARY_INBOX_SECONDS=30
# LIBRARY_INBOX_LABEL=/mnt/data/library/library/inbox
